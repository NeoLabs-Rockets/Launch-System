# NeoLabs Mission Dashboard runtime configuration.
# The launch code is intentionally not configurable here; it exists only in
# the ESP32 firmware and is verified through the active BLE owner.
PORT=3456
DATA_DIR=./data

# Launch controller OTA (GitHub release tag with firmware.bin + manifest.json)
# FIRMWARE_GITHUB_REPOSITORY=NeoLabs-Rockets/Launch-System
# FIRMWARE_RELEASE_TAG=firmware-latest

# Rocket computer OTA (XIAO ESP32-S3 Sense) — rolling release from NL-1-Pioneer
# RC_FIRMWARE_GITHUB_REPOSITORY=NeoLabs-Rockets/NL-1-Pioneer
# RC_FIRMWARE_RELEASE_TAG=rc-firmware-latest
